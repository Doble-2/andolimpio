---
// El Ávila (Waraira Repano) visto desde Caracas, de oeste a este:
// cumbre del Hotel Humboldt, la Silla de Caracas (picos Occidental y Oriental) y el Naiguatá.
// Arriba, el arco de las ocho estrellas de la bandera.
const stars = Array.from({ length: 8 }, (_, i) => {
  const a = ((205 + (i * 130) / 7) * Math.PI) / 180;
  return { x: 1120 + 150 * Math.cos(a), y: 78 + 70 * Math.sin(a) };
});
const star = 'M0,-7 L2.06,-2.83 L6.66,-2.16 L3.33,1.08 L4.11,5.66 L0,3.5 L-4.11,5.66 L-3.33,1.08 L-6.66,-2.16 L-2.06,-2.83Z';
---
<svg class="avila" viewBox="0 0 1440 360" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
  <g class="stars">{stars.map((s) => <path d={star} transform={`translate(${s.x.toFixed(1)} ${s.y.toFixed(1)})`} />)}</g>
  <path class="far" d="M0 236 L90 222 L170 214 L250 190 L330 184 L410 160 L480 154 L560 168 L640 150 L720 132 L790 140 L860 118 L940 128 L1010 108 L1090 98 L1170 118 L1250 140 L1330 162 L1440 176 L1440 360 L0 360Z" />
